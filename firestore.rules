rules_version = '2';

// Students can read and write only their own records, except their word list
// (/wordlists/{uid}) and the words added for all students (/classwords/{word}),
// which only teachers can change. A student can start using the app only after a
// teacher invites their email (/invites/{email}); students who signed in before
// invites existed keep access. A teacher can take a student's access away
// (/blocked/{email}), which shuts them out of their records until it's restored.
// Each student has a public profile (/profiles/{uid}: user name, picture, and
// leaderboard stats) that other students can read; /usernames/{name} keeps user
// names unique. Students pick their user name once; teachers can change it.
// Teachers can read everyone's records. The owner (listed in isAppOwner) is
// always a teacher and is the only one who can add or remove other teachers,
// who are stored in /teachers/{email}.
// SAT Transitions (sattransitions.web.app, its own repo) uses this project too. It
// shares sign-in, invites, teachers, blocked students, and profiles, and keeps its
// own records in /transitionusers, /transitionprogress, and /transitionstats.
// SAT Reading (satreading.web.app, its own repo) uses this project the same way,
// with its records in /readingusers, /readingprogress, and /readingchoices, and the
// shared question batches in /readingbatches (written by functions/reading.js).
// SAT Math (satmath.web.app, its own repo) works the same way, with /mathusers,
// /mathprogress, and /mathextra per student, the shared batches in /mathbatches,
// and every question the Math Tutor wrote in /mathpool (functions/math.js).
// /signincodes/{email} holds hashed email sign-in codes for functions/signin.js;
// no rule matches it, so no browser can read or write it.
// Publish with: npx -y firebase-tools@13.29.1 deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Keep in sync with OWNER_EMAILS in firebase-config.js.
    function isAppOwner() {
      return signedInEmail() && request.auth.token.email.lower() in ['tychung01@gmail.com'];
    }

    function isTeacher() {
      return isAppOwner()
        || (signedInEmail() && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower())));
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isInvited() {
      return signedInEmail()
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    // Teachers always can; anyone else, unless a teacher took their access away.
    function canStudy() {
      return isTeacher()
        || (signedInEmail()
          && !exists(/databases/$(database)/documents/blocked/$(request.auth.token.email.lower())));
    }

    // A profile as it will be after this write. Keep the user name pattern in sync
    // with USERNAME_PATTERN in avatars.js. photo is "", "avatar:<name>", or a small JPEG.
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(['username', 'photo', 'setStreak', 'lastSetDay', 'learned'])
        && d.keys().hasOnly(['username', 'photo', 'setStreak', 'lastSetDay', 'learned', 'updated'])
        && d.username is string && d.username.matches('[A-Za-z0-9_]{3,20}')
        && d.photo is string
        && (d.photo == '' || d.photo.matches('avatar:[a-z]+')
          || (d.photo.size() <= 40000 && d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && d.setStreak is int && d.setStreak >= 0 && d.setStreak <= 10000
        && d.lastSetDay is string && d.lastSetDay.size() <= 10
        && d.learned is int && d.learned >= 0 && d.learned <= 100000;
    }

    // Whether /usernames/{name} will belong to this uid after this write.
    function ownsUsername(uid) {
      return getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;
    }

    // A student's user record exists once they've signed in with access.
    function hasSignedIn(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // A student's SAT Transitions record exists once they've opened that app with access.
    function hasVisitedTransitions(uid) {
      return exists(/databases/$(database)/documents/transitionusers/$(uid));
    }

    // A student's SAT Reading record exists once they've opened that app with access.
    function hasVisitedReading(uid) {
      return exists(/databases/$(database)/documents/readingusers/$(uid));
    }

    // A student's SAT Math record exists once they've opened that app with access.
    function hasVisitedMath(uid) {
      return exists(/databases/$(database)/documents/mathusers/$(uid));
    }

    // SAT Transitions leaderboard numbers as they will be after this write.
    function validTransitionStats() {
      let d = request.resource.data;
      return d.keys().hasAll(['streak', 'lastDay', 'mastered'])
        && d.keys().hasOnly(['streak', 'lastDay', 'mastered', 'updated'])
        && d.streak is int && d.streak >= 0 && d.streak <= 10000
        && d.lastDay is string && d.lastDay.size() <= 10
        && d.mastered is int && d.mastered >= 0 && d.mastered <= 100000;
    }

    match /users/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create: if isSelf(uid) && canStudy() && (isInvited() || isTeacher());
      allow update: if isSelf(uid) && canStudy();

      match /logins/{loginId} {
        allow read: if (isSelf(uid) && canStudy()) || isTeacher();
        allow create: if isSelf(uid) && canStudy() && hasSignedIn(uid);
      }
    }

    match /progress/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create, update: if isSelf(uid) && canStudy() && hasSignedIn(uid);
    }

    // Public profiles, for the leaderboard. Students create theirs once, with a
    // user name nobody else has, then can change everything but the user name.
    match /profiles/{uid} {
      allow read: if request.auth != null && canStudy();
      allow create: if isSelf(uid) && canStudy() && (hasSignedIn(uid) || hasVisitedTransitions(uid))
        && validProfile() && ownsUsername(uid);
      allow update: if validProfile() && (
        (isSelf(uid) && canStudy() && request.resource.data.username == resource.data.username)
        || (isTeacher() && (request.resource.data.username == resource.data.username || ownsUsername(uid))));
      allow delete: if isTeacher();
    }

    // Taken user names. The document ID is the name, lowercased, holding { uid }.
    // A name can only be claimed along with the profile that uses it.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if name.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid'])
        && ((request.resource.data.uid == request.auth.uid && canStudy()) || isTeacher())
        && getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.uid)).data.username.lower() == name;
      allow delete: if isTeacher();
    }

    // Students a teacher invited. The document ID is the student's email, lowercased.
    match /invites/{email} {
      allow read, delete: if isTeacher();
      allow create: if isTeacher()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['email', 'invitedBy', 'invitedAt']);
    }

    // Students a teacher turned reminder emails off for. The document ID is the
    // student's uid. The reminder function (Admin SDK) only reads it.
    match /reminderoff/{uid} {
      allow read, delete: if isTeacher();
      allow create: if isTeacher() && request.resource.data.keys().hasOnly(['by', 'at']);
    }

    // Students whose access a teacher took away. The document ID is the student's
    // email, lowercased. Deleting it gives their access back.
    match /blocked/{email} {
      allow read, delete: if isTeacher();
      allow create: if isTeacher()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['email', 'blockedBy', 'blockedAt']);
    }

    // Words a teacher added or removed for one student. Only teachers change it.
    match /wordlists/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['added', 'removed', 'updated']);
    }

    // Words a teacher added for every student. The document ID is the word.
    match /classwords/{word} {
      allow read: if request.auth != null;
      allow create, update: if isTeacher() && request.resource.data.word == word;
      allow delete: if isTeacher();
    }

    // Database words a teacher took off every student's list. The document ID is the word.
    match /hiddenwords/{word} {
      allow read: if request.auth != null;
      allow create: if isTeacher()
        && request.resource.data.word == word
        && request.resource.data.keys().hasOnly(['word', 'removedBy', 'removedAt']);
      allow delete: if isTeacher();
    }

    // Every version of a word's content Claude wrote or a teacher saved
    // ({ word, versions: [{ source, content, at, by }] }); the add-word dialog starts
    // from the latest saved one. Teachers add versions; the writeWord function too.
    match /wordbank/{word} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() && request.resource.data.keys().hasOnly(['word', 'versions', 'updated'])
        && request.resource.data.versions is list;
    }

    match /teachers/{email} {
      allow read: if isTeacher();
      // The document ID must be the teacher's email, lowercased, matching the stored field.
      allow create: if isAppOwner()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['email', 'addedBy', 'addedAt']);
      allow delete: if isAppOwner();
    }

    // ---------- SAT Transitions ----------
    // Access works as in the word app: invited students, teachers, and students who
    // signed in to the word app before invites existed.

    // Visits, like /users: { name, email, photo, firstVisit, lastVisit, visitCount, ... }.
    match /transitionusers/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create: if isSelf(uid) && canStudy() && (isInvited() || isTeacher() || hasSignedIn(uid));
      allow update: if isSelf(uid) && canStudy();

      match /visits/{visitId} {
        allow read: if (isSelf(uid) && canStudy()) || isTeacher();
        allow create: if isSelf(uid) && canStudy() && hasVisitedTransitions(uid);
      }
    }

    // { words: { [transition]: { correct, wrong, last, ts, rightAt } },
    //   cards: { [transition]: { status, ts } },
    //   answers: { [question id]: { right, wrong, last, ts } } (from before words were tracked) }.
    match /transitionprogress/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create, update: if isSelf(uid) && canStudy() && hasVisitedTransitions(uid)
        && request.resource.data.keys().hasOnly(['answers', 'words', 'cards', 'updated']);
    }

    // Practice questions Claude wrote for the student (functions/transitions.js).
    // Only that function writes them.
    match /transitionquestions/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
    }

    // Every question Claude has written for a word, shared by all students; the
    // function gives each student ones they haven't seen. Only it writes them.
    match /transitionbank/{word} {
      allow read: if isTeacher();
    }

    // Leaderboard numbers, which other students can read with the profiles.
    match /transitionstats/{uid} {
      allow read: if request.auth != null && canStudy();
      allow create, update: if isSelf(uid) && canStudy() && hasVisitedTransitions(uid) && validTransitionStats();
      allow delete: if isTeacher();
    }

    // ---------- SAT Reading ----------
    // Access works as in SAT Transitions. Questions and their answer choices are
    // written only by functions/reading.js.

    // Visits: { name, email, photo, firstVisit, lastVisit, visitCount, ... }.
    match /readingusers/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create: if isSelf(uid) && canStudy() && (isInvited() || isTeacher() || hasSignedIn(uid) || hasVisitedTransitions(uid));
      allow update: if isSelf(uid) && canStudy();

      match /visits/{visitId} {
        allow read: if (isSelf(uid) && canStudy()) || isTeacher();
        allow create: if isSelf(uid) && canStudy() && hasVisitedReading(uid);
      }
    }

    // { batch, answers: { [question id]: { ok, t, sub, tries: [{ s, ok, at, p }] } },
    //   round: { ids, results, started } or null, rounds: [{ at, n, right, avg }] }.
    match /readingprogress/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create, update: if isSelf(uid) && canStudy() && hasVisitedReading(uid)
        && request.resource.data.keys().hasOnly(['batch', 'answers', 'round', 'rounds', 'updated']);
    }

    // New answer choices the Reviewer wrote for questions the student missed.
    match /readingchoices/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
    }

    // The shared batches of 150 questions. Teachers can pull a question
    // ({ pulled: { [question id]: { by, at } } }) so students skip it.
    match /readingbatches/{number} {
      allow read: if request.auth != null && canStudy() && (hasVisitedReading(request.auth.uid) || isTeacher());
      allow update: if isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pulled']);
    }

    // The batch being written: students see its status; teachers also see its items.
    match /readingjobs/{number} {
      allow read: if request.auth != null && canStudy() && (hasVisitedReading(request.auth.uid) || isTeacher());

      match /items/{itemId} {
        allow read: if isTeacher();
      }
    }

    // Which parts of which sources earlier batches used.
    match /readingmeta/{docId} {
      allow read: if isTeacher();
    }

    // Approved questions a batch didn't use, kept for the next batch.
    match /readingreserve/{itemId} {
      allow read: if isTeacher();
    }

    // Every set of new answer choices written for a question, shared by students
    // who miss it. Only the functions write them.
    match /readingchoicebank/{questionId} {
      allow read: if isTeacher();
    }

    // ---------- SAT Math ----------
    // Access works as in the other apps. Questions are written only by functions/math.js.

    match /mathusers/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create: if isSelf(uid) && canStudy()
        && (isInvited() || isTeacher() || hasSignedIn(uid) || hasVisitedTransitions(uid) || hasVisitedReading(uid));
      allow update: if isSelf(uid) && canStudy();

      match /visits/{visitId} {
        allow read: if (isSelf(uid) && canStudy()) || isTeacher();
        allow create: if isSelf(uid) && canStudy() && hasVisitedMath(uid);
      }
    }

    // { batch, answers: { [question id]: { ok, cleared, sk, ar, b, tries } }, round,
    //   rounds, sinceQuiz, quiz, quizzes }.
    match /mathprogress/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create, update: if isSelf(uid) && canStudy() && hasVisitedMath(uid)
        && request.resource.data.keys().hasOnly(['batch', 'answers', 'round', 'rounds', 'sinceQuiz', 'quiz', 'quizzes', 'updated']);
    }

    // Twin and fresh questions given to the student (written by the functions).
    match /mathextra/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
    }

    // The shared batches. Teachers can pull a question ({ pulled: { [id]: { by, at } } }).
    match /mathbatches/{number} {
      allow read: if request.auth != null && canStudy() && (hasVisitedMath(request.auth.uid) || isTeacher());
      allow update: if isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pulled']);
    }

    match /mathjobs/{number} {
      allow read: if request.auth != null && canStudy() && (hasVisitedMath(request.auth.uid) || isTeacher());

      match /items/{itemId} {
        allow read: if isTeacher();
      }
    }

    // Every question the Math Tutor wrote. Teachers can pull one so no batch,
    // twin, or fresh question uses it.
    match /mathpool/{questionId} {
      allow read: if isTeacher();
      allow update: if isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pulled']);
    }
  }
}
