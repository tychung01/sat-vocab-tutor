rules_version = '2';

// Students can read and write only their own records, except their word list
// (/wordlists/{uid}) and the words added for all students (/classwords/{word}),
// which only teachers can change. A student can start using the app only after a
// teacher invites their email (/invites/{email}); students who signed in before
// invites existed keep access. A teacher can take a student's access away
// (/blocked/{email}), which shuts them out of their records until it's restored.
// Each student has a public profile (/profiles/{uid}: user name, picture, and
// leaderboard stats) that other students can read; /usernames/{name} keeps user
// names unique. Students pick their user name once; teachers can change it.
// Teachers can read everyone's records. The owner (listed in isAppOwner) is
// always a teacher and is the only one who can add or remove other teachers,
// who are stored in /teachers/{email}.
// Publish with: npx -y firebase-tools@13.29.1 deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Keep in sync with OWNER_EMAILS in firebase-config.js.
    function isAppOwner() {
      return signedInEmail() && request.auth.token.email.lower() in ['tychung01@gmail.com'];
    }

    function isTeacher() {
      return isAppOwner()
        || (signedInEmail() && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower())));
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isInvited() {
      return signedInEmail()
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()));
    }

    // Teachers always can; anyone else, unless a teacher took their access away.
    function canStudy() {
      return isTeacher()
        || (signedInEmail()
          && !exists(/databases/$(database)/documents/blocked/$(request.auth.token.email.lower())));
    }

    // A profile as it will be after this write. Keep the user name pattern in sync
    // with USERNAME_PATTERN in avatars.js. photo is "", "avatar:<name>", or a small JPEG.
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(['username', 'photo', 'setStreak', 'lastSetDay', 'learned'])
        && d.keys().hasOnly(['username', 'photo', 'setStreak', 'lastSetDay', 'learned', 'updated'])
        && d.username is string && d.username.matches('[A-Za-z0-9_]{3,20}')
        && d.photo is string
        && (d.photo == '' || d.photo.matches('avatar:[a-z]+')
          || (d.photo.size() <= 40000 && d.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && d.setStreak is int && d.setStreak >= 0 && d.setStreak <= 10000
        && d.lastSetDay is string && d.lastSetDay.size() <= 10
        && d.learned is int && d.learned >= 0 && d.learned <= 100000;
    }

    // Whether /usernames/{name} will belong to this uid after this write.
    function ownsUsername(uid) {
      return getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;
    }

    // A student's user record exists once they've signed in with access.
    function hasSignedIn(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    match /users/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create: if isSelf(uid) && canStudy() && (isInvited() || isTeacher());
      allow update: if isSelf(uid) && canStudy();

      match /logins/{loginId} {
        allow read: if (isSelf(uid) && canStudy()) || isTeacher();
        allow create: if isSelf(uid) && canStudy() && hasSignedIn(uid);
      }
    }

    match /progress/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create, update: if isSelf(uid) && canStudy() && hasSignedIn(uid);
    }

    // Public profiles, for the leaderboard. Students create theirs once, with a
    // user name nobody else has, then can change everything but the user name.
    match /profiles/{uid} {
      allow read: if request.auth != null && canStudy();
      allow create: if isSelf(uid) && canStudy() && hasSignedIn(uid) && validProfile() && ownsUsername(uid);
      allow update: if validProfile() && (
        (isSelf(uid) && canStudy() && request.resource.data.username == resource.data.username)
        || (isTeacher() && (request.resource.data.username == resource.data.username || ownsUsername(uid))));
      allow delete: if isTeacher();
    }

    // Taken user names. The document ID is the name, lowercased, holding { uid }.
    // A name can only be claimed along with the profile that uses it.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if name.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid'])
        && ((request.resource.data.uid == request.auth.uid && canStudy()) || isTeacher())
        && getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.uid)).data.username.lower() == name;
      allow delete: if isTeacher();
    }

    // Students a teacher invited. The document ID is the student's email, lowercased.
    match /invites/{email} {
      allow read, delete: if isTeacher();
      allow create: if isTeacher()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['email', 'invitedBy', 'invitedAt']);
    }

    // Students whose access a teacher took away. The document ID is the student's
    // email, lowercased. Deleting it gives their access back.
    match /blocked/{email} {
      allow read, delete: if isTeacher();
      allow create: if isTeacher()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['email', 'blockedBy', 'blockedAt']);
    }

    // Words a teacher added or removed for one student. Only teachers change it.
    match /wordlists/{uid} {
      allow read: if (isSelf(uid) && canStudy()) || isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['added', 'removed', 'updated']);
    }

    // Words a teacher added for every student. The document ID is the word.
    match /classwords/{word} {
      allow read: if request.auth != null;
      allow create, update: if isTeacher() && request.resource.data.word == word;
      allow delete: if isTeacher();
    }

    // Database words a teacher took off every student's list. The document ID is the word.
    match /hiddenwords/{word} {
      allow read: if request.auth != null;
      allow create: if isTeacher()
        && request.resource.data.word == word
        && request.resource.data.keys().hasOnly(['word', 'removedBy', 'removedAt']);
      allow delete: if isTeacher();
    }

    match /teachers/{email} {
      allow read: if isTeacher();
      // The document ID must be the teacher's email, lowercased, matching the stored field.
      allow create: if isAppOwner()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['email', 'addedBy', 'addedAt']);
      allow delete: if isAppOwner();
    }
  }
}
