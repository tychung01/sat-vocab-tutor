rules_version = '2';

// Students can read and write only their own records.
// The teacher (listed in isAdmin) can read everyone's records.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['tychung01@gmail.com'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);

      match /logins/{loginId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
      }
    }

    match /progress/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
    }
  }
}
